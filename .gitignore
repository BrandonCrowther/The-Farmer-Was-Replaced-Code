# --- Game-owned files: never tracked, never written by us ---------------------
# save.json is live game state. The game rewrites it constantly; if git tracked it,
# a checkout/stash/reset could clobber a live save. Read it never, write it never.
save/Save0/save.json
# __builtins__.py is regenerated by the game to match unlock state + version.
# The tracked, reviewable snapshot lives in docs/api/__builtins__.py instead.
save/Save0/__builtins__.py

# --- Archives -----------------------------------------------------------------
**.zip

# --- Capture artifacts --------------------------------------------------------
logs/**/*.png
logs/**/*.jpg
logs/**/*.txt
!logs/.gitkeep
